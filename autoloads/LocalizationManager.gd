func _ready() -> void:
	current_lang = SaveManager.get_value("language", "en")

func t(key: String) -> String:
	if dicts.has(current_lang) and dicts[current_lang].has(key):
		return dicts[current_lang][key]
	elif dicts["en"].has(key):
		return dicts["en"][key]
	return key
